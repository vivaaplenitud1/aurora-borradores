# Copiar a .env en el VPS (chmod 600). En GitHub: Settings → Secrets and variables → Actions.

# WordPress (usuario Colaborador Aurora + Application Password)
WP_URL=https://usagastosfinales.com
WP_USER=Aurora
WP_APP_PASSWORD=

# Gemini (nivel Free, SIN facturación) — https://aistudio.google.com
GEMINI_API_KEY=

# Opcional: respaldo GLM-4.7-Flash por API general de z.ai (NO el plan Coding)
GLM_API_KEY=
# Alias aceptado:
# ZAI_API_KEY=

# Opcionales (no usados en el script mínimo actual; reservados para cadena ampliada)
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Opcional: IDs de imágenes ya subidas (el Colaborador no puede subir)
FEATURED_IMAGE_IDS=

# Opcional: modelos Gemini en orden (si Google retira uno, cambie esta lista)
# GEMINI_MODELS=gemini-3.8-flash,gemini-flash-latest,gemini-3.5-flash-lite
